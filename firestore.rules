rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && userRole() == "admin"; }
    function isStudent() { return signedIn() && userRole() == "student"; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      // Full quiz documents are NEVER readable by students; they contain correctIndex.
      allow read: if signedIn() && !isStudent();
      allow create: if signedIn() && userRole() in ["teacher", "school", "coaching", "admin"];
      allow update, delete: if signedIn() &&
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /publicQuizzes/{quizId} {
      allow read: if isStudent();
      allow create, update: if signedIn() &&
        (request.resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if signedIn() &&
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /quizAttempts/{attemptId} {
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && attemptId == request.resource.data.quizId + "_" + request.auth.uid
        && !exists(/databases/$(database)/documents/quizAttempts/$(attemptId));
      allow read: if signedIn() &&
        (resource.data.studentUid == request.auth.uid ||
         resource.data.quizOwnerUid == request.auth.uid ||
         isAdmin());
      allow update, delete: if false;
    }
  }
}
